[Unit]
Description=Windmilled - Wind Turbine Configuration Manager
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/windmilled
ExecStart=/usr/bin/python3 /root/windmilled/app.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
