[Unit]
Description=Sunspire Energy Projections
After=network.target

[Service]
Type=simple
User=crucible
Group=crucible
WorkingDirectory=/var/www/energy-projections
ExecStart=/usr/bin/python3 /var/www/energy-projections/app.py
Restart=always
RestartSec=5
EnvironmentFile=/var/www/energy-projections/.env

[Install]
WantedBy=multi-user.target
