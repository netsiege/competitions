[Unit]
Description=Sunspire Energy Projections
After=network.target

[Service]
Type=simple
User=crucible
Group=crucible
WorkingDirectory=/var/www/energy-projections
ExecStart=/var/www/energy-projections/venv/bin/python /var/www/energy-projections/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
